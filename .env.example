# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cafe_management

# Sessions — REQUIRED in production (the server refuses to boot on placeholders)
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Frontend origins allowed by CORS (comma separated allowlist)
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://app.example.com,https://preview.example.com

# Proxy hops in front of the app (Render/Railway/Fly: 1)
# TRUST_PROXY=1

# Optional shared key that locks the public TV board room
# DISPLAY_TOKEN=

# AI chat (optional; disabled with a clear message when unset)
# GROQ_API_KEY=

# Cookie
COOKIE_SECRET=your_cookie_secret_here

# QR Token Secret
QR_TOKEN_SECRET=your_qr_token_secret
